# Supabase > Connect > Connection string > Method: "Transaction pooler" (shared pooler, free, IPv4).
# The host must end in pooler.supabase.com and the user must be postgres.<project-ref>.
# Do not use db.<project-ref>.supabase.co: it is IPv6 only and Vercel cannot reach it
# (unless you buy the IPv4 add-on and set ALLOW_DIRECT_DB=1).
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: signs login sessions. If empty, one is generated and stored in the database.
SESSION_SECRET=
# Optional: the admin account created on first start (it must change this password at first login)
ADMIN_EMAIL=admin@dvsum.com
ADMIN_INITIAL_PASSWORD=ChangeMe
# 1 = create tables automatically on first request
AUTO_MIGRATE=1
